# Contact form delivery (app/contact/actions.ts) via https://resend.com
# Copy to .env.local and fill in. Without RESEND_API_KEY + CONTACT_TO_EMAIL the form
# shows a "not connected yet" message pointing visitors to your email.

RESEND_API_KEY=
# Where inquiries are delivered (your inbox).
CONTACT_TO_EMAIL=
# Sender. Must use a domain verified in Resend. "onboarding@resend.dev" works for testing,
# but only delivers to the email address that owns the Resend account.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
